{
  "default_agent": "echo",
  "data_dir": "./data",
  "skills_dir": "./skills",
  "memory": {
    "enabled": true,
    "max_messages": 20
  },
  "sandbox": {
    "allow_commands": ["echo", "date", "uname"]
  },
  "bindings": [],
  "agents": {
    "echo": {
      "mode": "cli",
      "command": "echo",
      "args": ["meclaw:"]
    },
    "weekly": {
      "mode": "cli",
      "command": "echo",
      "args": ["weekly:"],
      "skill": "examples/weekly-report"
    },
    "openai-demo": {
      "mode": "openai",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "api_key": ""
    },
    "claude": {
      "mode": "acp",
      "command": "claude"
    },
    "codex": {
      "mode": "cli",
      "command": "codex",
      "args": ["exec"]
    },
    "http-demo": {
      "mode": "http",
      "base_url": "http://127.0.0.1:9000/v1/run"
    }
  },
  "policy": {
    "allow_tools": ["echo", "shell"],
    "allow_users": []
  },
  "gateway": {
    "listen": ":8080",
    "channels": {
      "feishu": {
        "app_id": "",
        "app_secret": "",
        "verification_token": "",
        "encrypt_key": ""
      }
    }
  }
}
